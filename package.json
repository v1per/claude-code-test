{
  "name": "notes-app-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for Notes App - Backend API and Frontend",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @notes-app/backend dev",
    "dev:backend": "pnpm --filter @notes-app/backend dev",
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter @notes-app/backend build",
    "start:backend": "pnpm --filter @notes-app/backend start",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @notes-app/backend test",
    "test:run": "pnpm -r test:run",
    "test:ui": "pnpm --filter @notes-app/backend test:ui",
    "db:generate": "pnpm --filter @notes-app/backend db:generate",
    "db:migrate": "pnpm --filter @notes-app/backend db:migrate",
    "db:push": "pnpm --filter @notes-app/backend db:push",
    "db:studio": "pnpm --filter @notes-app/backend db:studio"
  },
  "keywords": [
    "monorepo",
    "pnpm",
    "workspace",
    "notes-app"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
